{
    "name": "raxos/rate-limit",
    "description": "Rate Limit for raxos/router.",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "type": "library",
    "authors": [
        {
            "name": "Bas Milius",
            "email": "bas@mili.us"
        }
    ],
    "autoload": {
        "psr-4": {
            "Raxos\\RateLimit\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "symlink": true
        }
    ],
    "require": {
        "jetbrains/phpstorm-attributes": "^1.2",
        "php": ">=8.5",
        "raxos/cache": "*",
        "raxos/contract": "*",
        "raxos/error": "*",
        "raxos/foundation": "*",
        "raxos/http": "*",
        "raxos/router": "*"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload-dev": {
        "classmap": [
            "tests/Fixtures/"
        ]
    },
    "scripts": {
        "test": "pest --compact"
    }
}
